# Application
APP_URL=http://localhost:3000
# Stable base64 32-byte key when Server Actions run across more than one instance.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only configuration. Required in every live worker deployment;
# never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Required before real OAuth tokens are stored. Generate a base64-encoded 32-byte AES-256 key.
INTEGRATION_ENCRYPTION_KEY=

# Hermes bridge on the long-running VPS/container
HERMES_BRIDGE_URL=
HERMES_BRIDGE_TOKEN=

# Google OAuth and Routes
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ROUTES_API_KEY=

# Protected Vercel Cron / worker endpoint for tenant automations. Required in
# production with SUPABASE_SERVICE_ROLE_KEY; use a unique random value (32+ chars).
CRON_SECRET=

# WhatsApp Cloud API
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional direct-response LLM layer. Hermes remains the primary intent runtime.
# Set LLM_PROVIDER only together with that provider's key and a fixed explicit
# Production model ID. For the explicitly approved connectivity-testing phase,
# OPENROUTER_MODEL=openrouter/free is permitted; do not enable paid routing,
# paid models, or a paid budget without approval.
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
